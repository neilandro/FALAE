# ============================================================
# FALAE Enterprise
# Modelo de variáveis para ambiente de produção
#
# IMPORTANTE:
# - Não colocar senhas reais neste arquivo.
# - No Dokploy, cadastrar os valores na área Environment.
# - Nunca versionar o arquivo .env real de produção.
# ============================================================


# ------------------------------------------------------------
# APLICAÇÃO
# ------------------------------------------------------------

APP_ENV=production
ENVIRONMENT=production

APP_NAME=FALAE
APP_VERSION=1.0.0

TZ=America/Sao_Paulo


# ------------------------------------------------------------
# SEGREDO DA APLICAÇÃO
# ------------------------------------------------------------

# Gere uma chave aleatória forte com pelo menos 32 caracteres.
#
# Exemplo para gerar no terminal:
#
# python -c "import secrets; print(secrets.token_urlsafe(64))"
#
SECRET_KEY=SUBSTITUIR_POR_UMA_CHAVE_FORTE


# ------------------------------------------------------------
# BANCO DE DADOS — APLICAÇÃO
# ------------------------------------------------------------

DB_HOST=db
DB_PORT=3306
DB_NAME=falae
DB_USER=falae_app
DB_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE

DB_CONNECTION_TIMEOUT=10


# ------------------------------------------------------------
# BANCO DE DADOS — CONTAINER MYSQL
# ------------------------------------------------------------

MYSQL_DATABASE=falae
MYSQL_USER=falae_app
MYSQL_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
MYSQL_ROOT_PASSWORD=SUBSTITUIR_POR_SENHA_ROOT_FORTE


# ------------------------------------------------------------
# ARQUIVOS E LOGS
# ------------------------------------------------------------

UPLOAD_FOLDER=/app/uploads
LOG_FOLDER=/app/logs

# Limite global aceito pelo Flask.
# Valor em bytes: 16 MB.
MAX_CONTENT_LENGTH=16777216


# ------------------------------------------------------------
# SESSÃO
# ------------------------------------------------------------

SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax


# ------------------------------------------------------------
# CSRF
# ------------------------------------------------------------

WTF_CSRF_ENABLED=true
WTF_CSRF_SSL_STRICT=true

# Token CSRF válido por 2 horas.
WTF_CSRF_TIME_LIMIT_SECONDS=7200


# ------------------------------------------------------------
# PROXY REVERSO
# ------------------------------------------------------------

# Ativar somente em produção atrás do proxy do Dokploy/Traefik.
TRUST_PROXY_HEADERS=true


# ------------------------------------------------------------
# DOKPLOY / DOMÍNIO
# ------------------------------------------------------------

# Valores apenas informativos.
# O domínio e o certificado serão configurados no painel Dokploy.

APP_DOMAIN=app.seudominio.com.br
APP_SCHEME=https