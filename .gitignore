# ---------------------------------------------------------
uploads/*
static/uploads/*

!uploads/.gitkeep
!static/uploads/.gitkeep

# ---------------------------------------------------------
# Bancos locais, dumps e backups
# ---------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.dump
*.bak
*.sql.bak

backup/
backups/

